rules_version = '2';
// The Sundered Reach: each signed-in player can read and write only their own save, at saves/{their uid}.
// Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'savedAt', 'v'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.savedAt is number;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
